@inject NavigationManager NavigationManager
@inject CurrentUserService CurrentUser
@inject IPermissionService PermissionService

<nav id="mo-sb-nav">

    <div class="mo-sb-section-label">Principal</div>
    <NavLink class="mo-sb-item" href="" Match="NavLinkMatch.All" title="Dashboard">
        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" />
        </svg>
        <span class="mo-sb-label">Dashboard</span>
    </NavLink>

    <div class="mo-sb-section-label">Solicitudes</div>
    <NavLink class="mo-sb-item" href="requests/new" title="Nueva Solicitud">
        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2v20M2 12h20" />
        </svg>
        <span class="mo-sb-label">Nueva Solicitud</span>
    </NavLink>
    <NavLink class="mo-sb-item" href="requests" title="Mis Solicitudes">
        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" x2="21" y1="6" y2="6" /><line x1="8" x2="21" y1="12" y2="12" />
            <line x1="8" x2="21" y1="18" y2="18" /><line x1="3" x2="3.01" y1="6" y2="6" />
            <line x1="3" x2="3.01" y1="12" y2="12" /><line x1="3" x2="3.01" y1="18" y2="18" />
        </svg>
        <span class="mo-sb-label">Mis Solicitudes</span>
    </NavLink>

    <div class="mo-sb-section-label">Aprobaciones</div>
    <NavLink class="mo-sb-item" href="approvals" title="Pendientes">
        <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" />
        </svg>
        <span class="mo-sb-label">Pendientes</span>
    </NavLink>

    @if (_isAdmin)
    {
        <div class="mo-sb-section-label">Sistema</div>
        <NavLink class="mo-sb-item" href="admin" title="Administración">
            <svg class="mo-sb-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915" />
                <circle cx="12" cy="12" r="3" />
            </svg>
            <span class="mo-sb-label">Administración</span>
        </NavLink>
    }

</nav>

@code {
    private bool _isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(CurrentUser.Email))
            _isAdmin = await PermissionService.IsAdminAsync(CurrentUser.Email);
    }
}
