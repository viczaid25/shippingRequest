@page "/requests"
@using ShippingRequestSystem.Models
@using ShippingRequestSystem.Services
@using ShippingRequestSystem.Helpers
@inject IShippingRequestService RequestService
@inject CurrentUserService CurrentUser
@rendermode InteractiveServer

<PageTitle>Mis Solicitudes</PageTitle>

<div class="index-page">
    <div class="panel-card">
        <div class="panel-head">
            <div>
                <h2>Solicitudes de Envío</h2>
                <p class="panel-subtitle">Todas las solicitudes registradas en el sistema</p>
            </div>
            <a href="/requests/new" class="hero-btn primary"
               style="min-height:42px;padding:0.55rem 1.1rem;font-size:0.88rem;width:auto;border-radius:12px;">
                + Nueva
            </a>
        </div>

        @if (_loading)
        {
            <div class="index-loading" style="grid-template-columns:1fr;">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="index-skeleton" style="height:72px;border-radius:18px;"></div>
                }
            </div>
        }
        else if (!_requests.Any())
        {
            <div class="empty-state compact">
                Sin solicitudes — crea la primera desde el botón "+ Nueva"
            </div>
        }
        else
        {
            <div class="recent-list">
                @foreach (var r in _requests)
                {
                    bool isOwnDraft = r.Status == RequestStatus.Draft &&
                                       string.Equals(r.RequestorEmail, CurrentUser.Email,
                                                     StringComparison.OrdinalIgnoreCase);
                    string href = isOwnDraft ? "/requests/new" : $"/requests/{r.Id}";
                    <a href="@href" class="recent-item">
                        <div style="display:flex;align-items:center;gap:0.75rem;">
                            <div style="width:40px;height:40px;border-radius:12px;background:#eff6ff;
                                        display:flex;align-items:center;justify-content:center;
                                        font-size:1.1rem;flex-shrink:0;">
                                @r.ToShipmentIcon()
                            </div>
                            <div>
                                <strong>@(r.Folio ?? $"SR-{r.Id}") — @r.RecipientBusinessName</strong>
                                <span>@r.Department · @r.ShippingWay.ToDisplayName() · @r.ServiceType.ToDisplayName()</span>
                            </div>
                        </div>
                        <div class="recent-meta">
                            <small>@r.RequestDate.ToString("dd MMM yyyy")</small>
                            <StatusBadge Status="@r.Status" />
                            @if (r.ApproximateCost >= 5000)
                            {
                                <span style="font-size:0.72rem;font-weight:900;color:#d97706;">⭐ PREMIUM</span>
                            }
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<ShippingRequest> _requests = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        _requests = await RequestService.GetAllAsync();
        _loading  = false;
    }
}