@page "/requests/{Id:int}/premium-freight"
@using ShippingRequestSystem.Models
@using ShippingRequestSystem.Services
@using ShippingRequestSystem.Helpers
@inject IShippingRequestService RequestService
@inject IQuoteService QuoteService
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Premium Freight — #@Id</PageTitle>

@if (_loading)
{
    <div class="index-loading">
        <div class="index-skeleton skeleton-card"></div>
    </div>
}
else if (_request is null)
{
    <div class="empty-state compact">Solicitud no encontrada.</div>
}
else
{
    <div class="detail-page">

        <div class="detail-hero" style="background:linear-gradient(135deg,#78350f,#92400e);">
            <div class="detail-hero-left">
                <div class="detail-hero-id">PREMIUM FREIGHT · #@_request.Id</div>
                <h1>@_request.RecipientBusinessName</h1>
                <div style="color:rgba(255,255,255,0.7);font-size:0.92rem;">
                    Costo seleccionado: $@_request.ApproximateCost.ToString("N2") USD
                </div>
            </div>
            <div class="detail-hero-right">
                <div class="premium-badge"> ≥ $5,000 USD</div>
            </div>
        </div>

        <div class="info-card" style="border-color:#f59e0b;">
            <div class="info-card-header" style="background:#fef3c7;">
                <h3 class="info-card-title">Información de Premium Freight</h3>
            </div>
            <div class="info-card-body">

                <!-- Dirección / Alcance / Transporte / Pago -->
                <div class="field-row">
                    <div class="mo-form-group">
                        <label class="mo-form-label">Dirección</label>
                        <div class="radio-group">
                            @foreach (var d in Enum.GetValues<PremiumFreightDirection>())
                            {
                                <span class="radio-chip @(_pf.Direction == d ? "selected" : "")"
                                      @onclick="() => _pf.Direction = d">@d</span>
                            }
                        </div>
                    </div>
                    <div class="mo-form-group">
                        <label class="mo-form-label">Alcance</label>
                        <div class="radio-group">
                            @foreach (var s in Enum.GetValues<PremiumFreightScope>())
                            {
                                <span class="radio-chip @(_pf.Scope == s ? "selected" : "")"
                                      @onclick="() => _pf.Scope = s">@s</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="field-row">
                    <div class="mo-form-group">
                        <label class="mo-form-label">Tipo de Transporte</label>
                        <div class="radio-group">
                            @foreach (var t in Enum.GetValues<PremiumFreightTransport>())
                            {
                                <span class="radio-chip @(_pf.Transport == t ? "selected" : "")"
                                      @onclick="() => _pf.Transport = t">
                                    @t.ToDisplayName()
                                </span>
                            }
                        </div>
                    </div>
                    <div class="mo-form-group">
                        <label class="mo-form-label">Responsabilidad de Pago</label>
                        <div class="radio-group">
                            @foreach (var p in Enum.GetValues<PremiumFreightPayment>())
                            {
                                <span class="radio-chip @(_pf.Payment == p ? "selected" : "")"
                                      @onclick="() => _pf.Payment = p">
                                    @p.ToDisplayName()
                                </span>
                            }
                        </div>
                    </div>
                </div>

                <!-- Pick Up / Delivery -->
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.25rem;margin-top:0.5rem;">
                    <div>
                        <div style="font-weight:800;font-size:0.88rem;color:#92400e;margin-bottom:0.65rem;">
                             Pick Up At
                        </div>
                        <div class="mo-form-group" style="margin-bottom:0.65rem;">
                            <label class="mo-form-label">Nombre</label>
                            <input type="text" class="mo-form-control" @bind="_pf.PickUpName" />
                        </div>
                        <div class="mo-form-group" style="margin-bottom:0.65rem;">
                            <label class="mo-form-label">
                                Dirección <span style="color:#ef4444;">*</span>
                            </label>
                            <textarea class="mo-form-control @(_errors.Contains("PickUpAddress") ? "invalid" : "")"
                                      style="min-height:70px;"
                                      @bind="_pf.PickUpAddress"></textarea>
                            @if (_errors.Contains("PickUpAddress"))
                            {
                                <span class="mo-form-error">La dirección de recolección es requerida</span>
                            }
                        </div>
                        <div class="mo-form-group">
                            <label class="mo-form-label">Persona de Contacto</label>
                            <input type="text" class="mo-form-control" @bind="_pf.PickUpContact" />
                        </div>
                    </div>
                    <div>
                        <div style="font-weight:800;font-size:0.88rem;color:#92400e;margin-bottom:0.65rem;">
                             Delivery At
                        </div>
                        <div class="mo-form-group" style="margin-bottom:0.65rem;">
                            <label class="mo-form-label">Nombre</label>
                            <input type="text" class="mo-form-control" @bind="_pf.DeliveryName" />
                        </div>
                        <div class="mo-form-group" style="margin-bottom:0.65rem;">
                            <label class="mo-form-label">
                                Dirección <span style="color:#ef4444;">*</span>
                            </label>
                            <textarea class="mo-form-control @(_errors.Contains("DeliveryAddress") ? "invalid" : "")"
                                      style="min-height:70px;"
                                      @bind="_pf.DeliveryAddress"></textarea>
                            @if (_errors.Contains("DeliveryAddress"))
                            {
                                <span class="mo-form-error">La dirección de entrega es requerida</span>
                            }
                        </div>
                        <div class="mo-form-group">
                            <label class="mo-form-label">Persona de Contacto</label>
                            <input type="text" class="mo-form-control" @bind="_pf.DeliveryContact" />
                        </div>
                    </div>
                </div>

                <div class="field-row" style="margin-top:0.75rem;">
                    <div class="mo-form-group">
                        <label class="mo-form-label">
                            Causa Raíz del Envío <span style="color:#ef4444;">*</span>
                        </label>
                        <textarea class="mo-form-control @(_errors.Contains("CauseOfShipment") ? "invalid" : "")"
                                  @bind="_pf.CauseOfShipment"
                                  placeholder="Describe la causa raíz y el producto..."></textarea>
                        @if (_errors.Contains("CauseOfShipment"))
                        {
                            <span class="mo-form-error">La causa raíz del envío es requerida</span>
                        }
                    </div>
                    <div class="mo-form-group">
                        <label class="mo-form-label">
                            Countermeasures
                            @if (_requiresCountermeasures)
                            {
                                <span style="color:#ef4444;">*</span>
                            }
                        </label>
                        <textarea class="mo-form-control @(_errors.Contains("Countermeasures") ? "invalid" : "")"
                                  @bind="_pf.Countermeasures"
                                  placeholder="Medidas correctivas..."></textarea>
                        @if (_requiresCountermeasures)
                        {
                            <div style="font-size:0.78rem;color:#d97706;margin-top:0.3rem;">
                                Requerido: esta solicitud es ≥ $5,000 USD.
                            </div>
                        }
                        @if (_errors.Contains("Countermeasures"))
                        {
                            <span class="mo-form-error">Las contramedidas son requeridas para esta solicitud</span>
                        }
                    </div>
                </div>

                <div class="field-row">
                    <div class="mo-form-group">
                        <label class="mo-form-label">Forwarder</label>
                        <input type="text" class="mo-form-control" @bind="_pf.Forwarder"
                               placeholder="Nombre del agente de carga" />
                    </div>
                    <div></div>
                </div>

            </div>
        </div>

        @if (!string.IsNullOrEmpty(_errorMsg))
        {
            <div style="padding:0.85rem 1rem;background:#fef2f2;border:1px solid #fecaca;
                                border-radius:14px;color:#dc2626;font-weight:700;">
                 @_errorMsg
            </div>
        }

        <div class="form-nav">
            <a href="requests/@Id/select-quote" class="mo-btn mo-btn-secondary">← Cambiar Cotización</a>
            <button type="button" class="mo-btn mo-btn-success" @onclick="Submit"
                    disabled="@_submitting">
                @if (_submitting)
                {
                    <span>Guardando...</span>
                }
                else
                {

                    <span>✓ Enviar a Aprobación</span>
                }
            </button>
        </div>

    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private ShippingRequest? _request;
    private PremiumFreightInfo _pf = new();
    private bool _loading = true;
    private bool _submitting = false;
    private string _errorMsg = string.Empty;
    private bool _requiresCountermeasures = false;
    private HashSet<string> _errors = new();

    protected override async Task OnInitializedAsync()
    {
        _request = await RequestService.GetByIdAsync(Id);
        if (_request?.PremiumFreightInfo is not null)
            _pf = _request.PremiumFreightInfo;

        // Contramedidas obligatorias cuando la solicitud califica como Premium Freight por monto (≥ $5,000 USD)
        _requiresCountermeasures = _request is not null && _request.ApproximateCost >= 5000;
        _loading = false;
    }

    private bool Validate()
    {
        _errors.Clear();

        if (string.IsNullOrWhiteSpace(_pf.CauseOfShipment))
            _errors.Add("CauseOfShipment");
        if (string.IsNullOrWhiteSpace(_pf.PickUpAddress))
            _errors.Add("PickUpAddress");
        if (string.IsNullOrWhiteSpace(_pf.DeliveryAddress))
            _errors.Add("DeliveryAddress");
        if (_requiresCountermeasures && string.IsNullOrWhiteSpace(_pf.Countermeasures))
            _errors.Add("Countermeasures");

        return _errors.Count == 0;
    }

    private async Task Submit()
    {
        if (!Validate())
        {
            _errorMsg = "Revisa los campos marcados antes de continuar.";
            return;
        }

        _submitting = true;
        _errorMsg = string.Empty;
        try
        {
            await QuoteService.SavePremiumFreightAsync(Id, _pf);
            Nav.NavigateTo($"requests/{Id}");
        }
        catch (Exception ex)
        {
            _errorMsg = $"Error: {ex.Message}";
            _submitting = false;
        }
    }
}