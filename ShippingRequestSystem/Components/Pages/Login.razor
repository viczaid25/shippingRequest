@page "/login"
@layout EmptyLayout
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager Nav

<PageTitle>Iniciar Sesión — Shipping Request System</PageTitle>

<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;
            background:var(--color-primary-gradient);">
    <div style="width:100%;max-width:420px;padding:1rem;">

        <!-- Logo -->
        <div style="text-align:center;margin-bottom:2rem;">
            <div style="color:#fff;font-size:1.4rem;font-weight:900;">ShipRequest</div>
            <div style="color:rgba(255,255,255,0.55);font-size:0.88rem;margin-top:0.25rem;">
                Shipping Request System
            </div>
        </div>

        <!-- Card -->
        <div style="background:#fff;border-radius:24px;padding:2rem;
                    box-shadow:0 32px 64px rgba(0,0,0,0.3);">

            <h2 style="margin:0 0 0.25rem;font-size:1.2rem;font-weight:900;color:#0f172a;">
                Iniciar Sesión
            </h2>
            <p style="margin:0 0 1.5rem;font-size:0.88rem;color:#64748b;">
                Usa tus credenciales de red MEAX
            </p>

            @if (!string.IsNullOrEmpty(_errorMsg))
            {
                <div class="mo-alert mo-alert-danger" style="margin-bottom:1.25rem;">
                    <span>@_errorMsg</span>
                </div>
            }

            <!-- Form que hace POST al AuthController -->
            <form method="post" action="/auth/login">
                <input type="hidden" name="returnUrl" value="@_returnUrl" />

                <div class="mo-form-group" style="margin-bottom:1rem;">
                    <label class="mo-form-label">Usuario</label>
                    <input type="text" name="username" class="mo-form-control"
                           placeholder="usuario.nombre"
                           autocomplete="username"
                           style="width:100%;box-sizing:border-box;" />
                </div>

                <div class="mo-form-group" style="margin-bottom:1.5rem;">
                    <label class="mo-form-label">Contraseña</label>
                    <input type="password" name="password" class="mo-form-control"
                           placeholder="••••••••"
                           autocomplete="current-password"
                           style="width:100%;box-sizing:border-box;" />
                </div>

                <button type="submit" class="mo-btn mo-btn-primary mo-btn-block mo-btn-lg">
                    Iniciar Sesión
                </button>
            </form>

            <div style="margin-top:1.25rem;text-align:center;
                        font-size:0.8rem;color:#94a3b8;">
                Dominio: <strong>MEAX</strong> · Soporte: IT Help Desk
            </div>
        </div>
    </div>
</div>

@code {
    private string _errorMsg = string.Empty;
    private string _returnUrl = "/";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("error", out var err))
            _errorMsg = err.ToString();

        if (query.TryGetValue("returnUrl", out var ret))
            _returnUrl = ret.ToString();
    }
}