@using ShippingRequestSystem.ViewModels
@using ShippingRequestSystem.Models
@using ShippingRequestSystem.Services
@inject IPartCatalogService PartCatalogService

<div class="items-table-wrap">
    <table class="items-table">
        <thead>
            <tr>
                <th>No. Parte</th>
                <th>Clase</th>
                <th>Descripción</th>
                <th>Cant.</th>
                <th>UOM</th>
                <th>Peso Neto</th>
                <th>Unit Price</th>
                <th>Amount</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Items)
            {
                <tr>
                    <td>
                        <input type="text" list="@_datalistId" placeholder="P/N"
                               style="min-width:110px;" @bind="item.PartNumber" />
                    </td>
                    <td><input type="text" placeholder="Clase" @bind="item.Class" /></td>
                    <td>
                        <input type="text" placeholder="Descripción"
                               style="min-width:140px;" @bind="item.Description" />
                    </td>
                    <td>
                        <input type="number" min="1" style="max-width:65px;"
                               @bind="item.Quantity" />
                    </td>
                    <td>
                        <select @bind="item.UOM" style="min-width:75px;">
                            <option value="">--</option>
                            <option>PCS</option>
                            <option>KG</option>
                            <option>LB</option>
                            <option>BOX</option>
                            <option>PLT</option>
                            <option>EA</option>
                            <option>SET</option>
                        </select>
                    </td>
                    <td>
                        <input type="number" step="0.01" min="0" style="max-width:80px;"
                               placeholder="0.00" @bind="item.NetWeight" />
                    </td>
                    <td>
                        <input type="number" step="0.01" min="0" style="max-width:85px;"
                               placeholder="$0.00" @bind="item.UnitPrice" />
                    </td>
                    <td style="font-weight:800;color:#0f172a;padding:0 0.5rem;white-space:nowrap;">
                        $@item.Amount.ToString("N2")
                    </td>
                    <td>
                        <button type="button" class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                @onclick="() => Items.Remove(item)">
                            ✕
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Items.Any())
{
    <div class="empty-state compact" style="margin-top:0.65rem;">
        Sin items — haz clic en "+ Item" para agregar
    </div>
}

<datalist id="@_datalistId">
    @foreach (var p in _catalog)
    {
        <option value="@p.PartNumber">@p.Description</option>
    }
</datalist>

@code {
    [Parameter] public List<ItemViewModel> Items { get; set; } = new();

    private readonly string _datalistId = $"partNumbers-{Guid.NewGuid():N}";
    private List<PartCatalog> _catalog = new();

    protected override async Task OnInitializedAsync()
    {
        _catalog = await PartCatalogService.GetAllActiveAsync();
    }
}