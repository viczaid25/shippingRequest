@using ShippingRequestSystem.Models

<div style="border:1.5px solid @(Quote.IsSelected ? "#3b82f6" : "#e2e8f0");
            border-radius:16px;padding:1.1rem;background:#fff;
            box-shadow:@(Quote.IsSelected ? "0 0 0 3px rgba(59,130,246,0.12)" : "none");">

    <div style="display:flex;align-items:center;justify-content:space-between;
                margin-bottom:0.65rem;flex-wrap:wrap;gap:0.35rem;">
        <span style="font-size:0.75rem;font-weight:800;color:#64748b;
                     text-transform:uppercase;letter-spacing:0.04em;">
            @Quote.ProviderName
        </span>
        <div style="display:flex;gap:0.4rem;flex-wrap:wrap;">
            @if (Quote.IsSelected)
            {
                <span style="background:#3b82f6;color:#fff;border-radius:999px;
                                 padding:0.2rem 0.65rem;font-size:0.72rem;font-weight:900;">
                    ✓ Seleccionada
                </span>
            }
            @if (Quote.Amount >= 5000)
            {
                <span style="background:#fef3c7;color:#d97706;border-radius:999px;
                                 padding:0.2rem 0.65rem;font-size:0.72rem;font-weight:900;">
                    Premium
                </span>
            }
        </div>
    </div>

    <div style="font-size:1.6rem;font-weight:900;
                color:@(Quote.Amount >= 5000 ? "#d97706" : "#0f172a");
                line-height:1;margin-bottom:0.5rem;">
        $@Quote.Amount.ToString("N2")
        <span style="font-size:0.8rem;font-weight:600;color:#64748b;">USD</span>
    </div>

    @if (!string.IsNullOrEmpty(Quote.Notes))
    {
        <div style="font-size:0.82rem;color:#64748b;margin-bottom:0.65rem;">
            @Quote.Notes
        </div>
    }

    <!-- Link al PDF -->
    @if (!string.IsNullOrEmpty(Quote.FilePath))
    {
        <a href="@Quote.FilePath?.TrimStart('/')" target="_blank"
           style="display:inline-flex;align-items:center;gap:0.4rem;
                      padding:0.4rem 0.85rem;border-radius:8px;
                      background:#fef2f2;color:#dc2626;font-weight:700;
                      font-size:0.8rem;text-decoration:none;
                      border:1px solid #fecaca;transition:all 0.18s ease;"
           onmouseover="this.style.background='#fee2e2'"
           onmouseout="this.style.background='#fef2f2'">
             Ver PDF — @Quote.FileName
        </a>
    }
    else
    {
        <span style="font-size:0.78rem;color:#94a3b8;font-style:italic;">
            Sin PDF adjunto
        </span>
    }
</div>

@code {
    [Parameter] public ShippingQuote Quote { get; set; } = null!;
}