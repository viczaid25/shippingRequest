@using ShippingRequestSystem.Models
@using ShippingRequestSystem.ViewModels

<div class="pkg-tree">
    @foreach (var pkg in Packages)
    {
        <div class="pkg-node @(pkg.PackageType == PackageType.Pallet ? "pallet" : "box")">
            <div class="pkg-node-header" @onclick="() => pkg.IsExpanded = !pkg.IsExpanded">
                <span class="pkg-node-title">
                    @(pkg.PackageType == PackageType.Pallet ? "Pallet" : "Caja")
                    @if (!string.IsNullOrEmpty(pkg.Label))
                    {
                        <span style="color:#64748b;font-weight:600;"> — @pkg.Label</span>
                    }
                </span>
                <div class="pkg-actions" @onclick:stopPropagation="true">
                    @if (pkg.PackageType == PackageType.Pallet)
                    {
                        <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-sm"
                                @onclick="() => AddBoxToPallet(pkg)">
                            + Caja
                        </button>
                    }
                    <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-sm"
                            @onclick="() => AddItemToPackage(pkg)">
                        + Item
                    </button>
                    <button type="button" class="mo-btn mo-btn-danger-outline mo-btn-sm"
                            @onclick="() => RemovePackage(pkg)">
                        ✕
                    </button>
                </div>
                <span style="color:#94a3b8;font-size:0.8rem;margin-left:0.25rem;">
                    @(pkg.IsExpanded ? "▲" : "▼")
                </span>
            </div>

            @if (pkg.IsExpanded)
            {
                <div class="pkg-node-body">
                    <div style="margin-bottom:0.75rem;">
                        <label class="mo-form-label">Etiqueta / Referencia</label>
                        <input type="text" class="mo-form-control" style="max-width:280px;"
                               placeholder="Ej: Pallet A, Caja 1..."
                               @bind="pkg.Label" />
                    </div>

                    @if (pkg.PackageType == PackageType.Pallet)
                    {
                        <div style="display:flex;gap:0.75rem;margin-bottom:0.75rem;flex-wrap:wrap;">
                            <div class="mo-form-group" style="max-width:120px;">
                                <label class="mo-form-label">Peso Bruto Pallet</label>
                                <input type="number" step="0.01" min="0" class="mo-form-control"
                                       placeholder="kg" @bind="pkg.GrossWeight" />
                            </div>
                            <div class="mo-form-group" style="max-width:100px;">
                                <label class="mo-form-label">Largo</label>
                                <input type="number" step="0.01" min="0" class="mo-form-control"
                                       placeholder="cm" @bind="pkg.Length" />
                            </div>
                            <div class="mo-form-group" style="max-width:100px;">
                                <label class="mo-form-label">Ancho</label>
                                <input type="number" step="0.01" min="0" class="mo-form-control"
                                       placeholder="cm" @bind="pkg.Width" />
                            </div>
                            <div class="mo-form-group" style="max-width:100px;">
                                <label class="mo-form-label">Alto</label>
                                <input type="number" step="0.01" min="0" class="mo-form-control"
                                       placeholder="cm" @bind="pkg.Height" />
                            </div>
                        </div>
                    }

                    @if (pkg.PackageType == PackageType.Pallet && pkg.ChildBoxes.Any())
                    {
                        <div class="pkg-child-list">
                            @foreach (var box in pkg.ChildBoxes)
                            {
                                <div class="pkg-node box">
                                    <div class="pkg-node-header"
                                         @onclick="() => box.IsExpanded = !box.IsExpanded">
                                        <span class="pkg-node-title">
                                            Caja
                                            @if (!string.IsNullOrEmpty(box.Label))
                                            {
                                                <span style="color:#64748b;font-weight:600;">
                                                    — @box.Label
                                                </span>
                                            }
                                        </span>
                                        <div class="pkg-actions" @onclick:stopPropagation="true">
                                            <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-sm"
                                                    @onclick="() => AddItemToPackage(box)">
                                                + Item
                                            </button>
                                            <button type="button" class="mo-btn mo-btn-danger-outline mo-btn-sm"
                                                    @onclick="() => RemoveBoxFromPallet(pkg, box)">
                                                ✕
                                            </button>
                                        </div>
                                        <span style="color:#94a3b8;font-size:0.8rem;margin-left:0.25rem;">
                                            @(box.IsExpanded ? "▲" : "▼")
                                        </span>
                                    </div>

                                    @if (box.IsExpanded)
                                    {
                                        <div class="pkg-node-body">
                                            <div style="margin-bottom:0.75rem;">
                                                <label class="mo-form-label">Etiqueta</label>
                                                <input type="text" class="mo-form-control"
                                                       style="max-width:280px;"
                                                       placeholder="Ej: Caja 1..."
                                                       @bind="box.Label" />
                                            </div>
                                            <ItemsTable Items="box.Items" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <ItemsTable Items="pkg.Items" />
                </div>
            }
        </div>
    }
</div>

<!-- Botones raíz -->
<div style="display:flex;gap:0.75rem;margin-top:1rem;">
    <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-sm"
            style="padding:0.6rem 1.2rem;border-radius:12px;"
            @onclick="AddPallet">
         Agregar Pallet
    </button>
    <button type="button" class="mo-btn mo-btn-secondary-outline mo-btn-sm"
            style="padding:0.6rem 1.2rem;border-radius:12px;"
            @onclick="AddBox">
         Agregar Caja
    </button>
</div>

@code {
    [Parameter] public List<PackageViewModel> Packages { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private void AddPallet()
    {
        Packages.Add(new PackageViewModel { PackageType = PackageType.Pallet, IsExpanded = true });
        OnChanged.InvokeAsync();
    }

    private void AddBox()
    {
        Packages.Add(new PackageViewModel { PackageType = PackageType.Box, IsExpanded = true });
        OnChanged.InvokeAsync();
    }

    private void AddBoxToPallet(PackageViewModel pallet)
    {
        pallet.ChildBoxes.Add(new PackageViewModel
        {
            PackageType = PackageType.Box,
            IsExpanded = true
        });
        OnChanged.InvokeAsync();
    }

    private void AddItemToPackage(PackageViewModel pkg)
    {
        pkg.Items.Add(new ItemViewModel());
        OnChanged.InvokeAsync();
    }

    private void RemovePackage(PackageViewModel pkg)
    {
        Packages.Remove(pkg);
        OnChanged.InvokeAsync();
    }

    private void RemoveBoxFromPallet(PackageViewModel pallet, PackageViewModel box)
    {
        pallet.ChildBoxes.Remove(box);
        OnChanged.InvokeAsync();
    }
}