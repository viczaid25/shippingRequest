@using ShippingRequestSystem.Auth
@inject AuthMode AuthMode
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Shipping Request System</title>
    @* PathBase-aware: la app puede correr como sub-aplicación de IIS *@
    <base href="@BaseHref" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />
    <!-- MEAX One — hoja de estilos del sistema de diseño (sin modificar) -->
    <link rel="stylesheet" href="css/meaxone-template.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/form.css" />
    <link rel="stylesheet" href="css/detail.css" />
    <HeadOutlet />
</head>
<body class="mo-body">
    <CascadingAuthenticationState>
        <Routes />
    </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js"></script>
    <!-- MEAX One — filtros y paginación de tablas .mo-table (sin modificar) -->
    <script src="js/meaxone-table.js"></script>

    @if (!AuthMode.DevLoginActivo && !string.IsNullOrWhiteSpace(HubBaseUrl))
    {
        @* Heartbeat: mantiene viva la cookie .MEAX.JWT del hub (8 h). Silencioso si el hub no responde. *@
        <script>
            (function () {
                var heartbeatUrl = '@HubBaseUrl/auth/heartbeat';

                function latido() {
                    try {
                        fetch(heartbeatUrl, { method: 'POST', credentials: 'include' })
                            .catch(function () { /* hub no disponible: ignorar */ });
                    } catch (e) { /* ignorar */ }
                }

                latido();
                setInterval(latido, 12 * 60 * 1000);
            })();
        </script>
    }
</body>
</html>

@code {
    [CascadingParameter]
    private Microsoft.AspNetCore.Http.HttpContext? HttpContext { get; set; }

    private string BaseHref => (HttpContext?.Request.PathBase.Value ?? string.Empty) + "/";

    private string? HubBaseUrl => Configuration["Hub:BaseUrl"]?.TrimEnd('/');
}